{
  "name": "kdw-max-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Рабочий корень MAX и Стеллы",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup:max": "npm --prefix apps/max-game/source/client ci --ignore-scripts",
    "setup:stela": "npm --prefix apps/stela/source/artifacts/stella-prototype ci --ignore-scripts",
    "setup": "npm ci --ignore-scripts && npm run setup:max && npm run setup:stela",
    "build:shared": "node apps/STARTUP/tools/sync-game-link.mjs",
    "build:max": "node apps/max-game/source/adapt-stand-main.mjs && node apps/max-game/source/build.mjs",
    "build:stela": "node apps/stela/source/typecheck.mjs && node apps/stela/source/build.mjs",
    "build": "npm run build:shared && npm run build:max && npm run build:stela",
    "check": "node apps/STARTUP/tools/check-package.mjs",
    "test:max": "npm --prefix apps/max-game/source/client test",
    "test:activity:webgl": "node ops/activity-webgl/verify-browser.mjs",
    "test:stela": "npm --prefix apps/stela/source/artifacts/stella-prototype test",
    "sync:check": "node ops/sync-workspace.mjs check",
    "sync:prepare": "node ops/sync-workspace.mjs prepare",
    "check:generated": "node apps/max-game/source/adapt-stand-main.mjs --check",
    "test:link": "node --test apps/STARTUP/tools/game-link.test.cjs apps/STARTUP/tools/async-link.test.cjs",
    "test:audit": "npm run check:generated && npm run test:max && npm run test:link && npm run test:stela && npm run test:stela:screen-api && npm run test:stela:presence && npm run test:stela:recorded && npm run test:stela:recovery && node apps/stela/source/typecheck.mjs && npm run test:runtime && npm run test:layout",
    "test:audit:browser": "node ops/audit-fixes/run-browser.mjs",
    "test:audit:profile": "node ops/audit-fixes/check-build-profile.mjs",
    "setup:browser": "playwright install chromium",
    "test:audit:retention": "node ops/audit-fixes/check-retention.mjs",
    "test:audit:all": "npm run test:audit && npm run test:audit:profile && npm run test:audit:retention && npm run test:audit:browser",
    "test:runtime": "node --test apps/STARTUP/tools/runtime-performance.test.cjs apps/STARTUP/tools/runtime-resilience.test.cjs apps/STARTUP/tools/spout-resilience.test.cjs",
    "test:stela:recovery": "node --test --test-isolation=none ops/audit-fixes/stela-touch-recovery.test.cjs",
    "test:layout": "node --test --test-isolation=none ops/production-build/layout-settings.test.cjs ops/production-build/manual-calibration.test.cjs apps/max-game/source/client/test/kdw-composition-layout.test.mjs",
    "test:layout:browser": "node ops/production-build/layout-browser.mjs",
    "test:stela:presence": "node --test --test-isolation=none ops/audit-fixes/stela-presence.test.cjs",
    "test:stela:recorded": "node --test --test-isolation=none ops/audit-fixes/stela-recorded.test.cjs",
    "test:stela:screen-api": "node --test --test-isolation=none ops/audit-fixes/stela-screen-api.test.cjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
