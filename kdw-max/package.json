{
  "name": "kdw-max-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Рабочий корень MAX и Стеллы",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup:max": "npm --prefix apps/max-game/source/client ci --ignore-scripts",
    "setup:stela": "npm --prefix apps/stela/source/artifacts/stella-prototype ci --ignore-scripts",
    "setup": "npm ci --ignore-scripts && npm run setup:max && npm run setup:stela",
    "build:shared": "node apps/STARTUP/tools/sync-game-link.mjs",
    "build:max": "node apps/max-game/source/adapt-stand-main.mjs && node apps/max-game/source/build.mjs",
    "build:stela": "node apps/stela/source/typecheck.mjs && node apps/stela/source/build.mjs",
    "build": "npm run build:shared && npm run build:max && npm run build:stela",
    "check": "node apps/STARTUP/tools/check-package.mjs",
    "test:max": "npm --prefix apps/max-game/source/client test",
    "test:stela": "npm --prefix apps/stela/source/artifacts/stella-prototype test",
    "sync:check": "node ops/sync-workspace.mjs check",
    "sync:prepare": "node ops/sync-workspace.mjs prepare",
    "check:generated": "node apps/max-game/source/adapt-stand-main.mjs --check",
    "test:link": "node --test apps/STARTUP/tools/game-link.test.cjs",
    "test:audit": "npm run check:generated && npm run test:max && npm run test:link && npm run test:stela && node apps/stela/source/typecheck.mjs",
    "test:audit:browser": "node ops/audit-fixes/run-browser.mjs",
    "test:audit:profile": "node ops/audit-fixes/check-build-profile.mjs",
    "setup:browser": "playwright install chromium",
    "test:audit:retention": "node ops/audit-fixes/check-retention.mjs",
    "test:audit:all": "npm run test:audit && npm run test:audit:profile && npm run test:audit:retention && npm run test:audit:browser"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
