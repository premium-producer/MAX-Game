{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "X-SPUTNIK Mission v2",
  "type": "object",
  "required": [
    "id",
    "number",
    "name",
    "description",
    "timeSeconds",
    "mapPosition",
    "endpoints",
    "topology",
    "objectives",
    "completion",
    "feedbackEvents",
    "unlock",
    "successText",
    "connectEndpointsOnComplete"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "timeSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "mapPosition": {
      "type": "object",
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -82,
          "maximum": 82
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "endpoints": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "latitude",
          "longitude",
          "icon"
        ],
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -82,
            "maximum": 82
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "label": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "start",
                "finish"
              ]
            },
            "description": "Назначение точки в редакторе; одна точка может начинать и завершать разные маршруты"
          },
          "size": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "signalRadius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "description": "Обязательный ID из system.pointIcons"
          }
        }
      }
    },
    "inventory": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!(?:__proto__|constructor|prototype)$)[a-zA-Z0-9_-]+$"
      },
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "topology": {
      "type": "object",
      "required": [
        "paths"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "from",
              "to",
              "steps"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "from": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "to": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "endpointSelection": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "enum": [
                      "specific",
                      "anyRole"
                    ],
                    "description": "specific — только path.from; anyRole — любая endpoint с ролью start"
                  },
                  "to": {
                    "enum": [
                      "specific",
                      "anyRole"
                    ],
                    "description": "specific — только path.to; anyRole — любая endpoint с ролью finish"
                  }
                }
              },
              "endpointSignals": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "from": {
                    "enum": [
                      "nearest",
                      "parallel"
                    ],
                    "description": "nearest — сигнал только от ближайшей стартовой точки; parallel — от всех стартовых точек в радиусе"
                  },
                  "to": {
                    "enum": [
                      "nearest",
                      "parallel"
                    ],
                    "description": "nearest — сигнал только к ближайшей завершающей точке; parallel — ко всем завершающим точкам в радиусе"
                  }
                }
              },
              "connection": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "policy": {
                    "enum": [
                      "geographicCorridor",
                      "screenProjected"
                    ]
                  },
                  "corridorWidth": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "ambiguityEpsilon": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "screen": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "corridorFraction": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1,
                        "default": 0.25
                      },
                      "ambiguityFraction": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "exclusiveMaximum": 0.5,
                        "default": 0.01
                      },
                      "minimumEndpointSpan": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 2000,
                        "default": 120
                      },
                      "iconGap": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 100,
                        "default": 8
                      },
                      "stableHoldMs": {
                        "type": "number",
                        "minimum": 100,
                        "maximum": 5000,
                        "default": 300
                      }
                    }
                  }
                }
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "role",
                    "type"
                  ],
                  "properties": {
                    "role": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]+$"
                    },
                    "type": {
                      "type": "string",
                      "pattern": "^(?!(?:__proto__|constructor|prototype)$)[a-zA-Z0-9_-]+$",
                      "description": "ID из mission-system.objectTypes"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "condition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "$ref": "#/$defs/condition"
          }
        },
        "additionalProperties": false
      }
    },
    "completion": {
      "$ref": "#/$defs/condition"
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invalid": {
          "enum": [
            "error",
            "neutral"
          ]
        }
      }
    },
    "feedbackEvents": {
      "$ref": "#/$defs/feedbackEvents"
    },
    "objectSettings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:(?!(?:__proto__|constructor|prototype)$)[a-zA-Z0-9_-]+|endpoint:[AB])$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "size": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "signalRadius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "radiusAtMinAltitude": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "radiusAtMaxAltitude": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minAltitude": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maxAltitude": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "defaultAltitude": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "description": "Ключи оборудования — ID из system.objectTypes. Допустимые поля зависят от behavior; проверяются runtime-парсером."
    },
    "successText": {
      "type": "string",
      "minLength": 1
    },
    "connectEndpointsOnComplete": {
      "type": "boolean"
    },
    "unlock": {
      "type": "object",
      "properties": {
        "requiresCompleted": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "engineVersion": {
      "const": 2
    },
    "_revision": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "equipmentSet": {
      "type": "string",
      "pattern": "^(?!(?:__proto__|constructor|prototype)$)[a-zA-Z0-9_-]+$",
      "description": "ID общего набора из system.equipmentSets. inventory при загрузке вычисляется из набора."
    },
    "summary": {
      "type": "string"
    },
    "level": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "feedbackEvents": {
      "type": "object",
      "required": [
        "success",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "success": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/successFeedbackEvent"
          }
        },
        "error": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/errorFeedbackEvent"
          }
        }
      }
    },
    "successFeedbackEvent": {
      "type": "object",
      "required": [
        "id",
        "eyebrow",
        "title",
        "message",
        "condition",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "eyebrow": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "condition": {
          "$ref": "#/$defs/feedbackCondition"
        },
        "action": {
          "enum": [
            "dismiss",
            "complete"
          ]
        }
      }
    },
    "errorFeedbackEvent": {
      "type": "object",
      "required": [
        "id",
        "eyebrow",
        "title",
        "message",
        "condition",
        "negativeConnections"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "eyebrow": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "condition": {
          "$ref": "#/$defs/feedbackCondition"
        },
        "negativeConnections": {
          "enum": [
            "none",
            "invalid",
            "matched",
            "all"
          ]
        }
      }
    },
    "feedbackCondition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "missionComplete"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "invalidConnection"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "objective"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "objectiveComplete"
            },
            "objective": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "pathComplete"
            },
            "path": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "object",
            "comparison",
            "value",
            "quantifier"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "altitude"
            },
            "object": {
              "type": "string",
              "pattern": "^(?!(?:__proto__|constructor|prototype)$)[a-zA-Z0-9_-]+$"
            },
            "comparison": {
              "enum": [
                "above",
                "below"
              ]
            },
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "quantifier": {
              "enum": [
                "any",
                "all"
              ]
            }
          }
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "allPaths"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "allPlaced"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "children"
          ],
          "properties": {
            "type": {
              "const": "all"
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "children"
          ],
          "properties": {
            "type": {
              "const": "any"
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "children"
          ],
          "properties": {
            "type": {
              "const": "not"
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "children",
            "count"
          ],
          "properties": {
            "type": {
              "const": "atLeast"
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              }
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "path"
          ],
          "properties": {
            "type": {
              "const": "path"
            },
            "path": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "path",
            "from",
            "to"
          ],
          "properties": {
            "type": {
              "const": "segment"
            },
            "path": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            },
            "from": {
              "type": "integer",
              "minimum": 0
            },
            "to": {
              "type": "integer",
              "minimum": 1
            },
            "anchor": {
              "enum": [
                "start",
                "end"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "object",
            "count"
          ],
          "properties": {
            "type": {
              "const": "placed"
            },
            "object": {
              "type": "string",
              "pattern": "^(?!(?:__proto__|constructor|prototype)$)[a-zA-Z0-9_-]+$"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "anyOf": [
    {
      "required": [
        "inventory"
      ]
    },
    {
      "required": [
        "equipmentSet"
      ]
    }
  ]
}
